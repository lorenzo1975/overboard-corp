# Mailgun delivery (Netlify Functions)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_TO_EMAIL=
MAILGUN_FROM_EMAIL=

# Telecom register (Netlify Functions)
TELECOM_REGISTER_AUTH_SHA256=
TELECOM_REGISTER_BLOB_KEY=

# Google Maps API Key (Client-side)
# This key is public. It's okay to expose this in your client-side code.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Google Analytics Measurement ID (Client-side)
NEXT_PUBLIC_GA_MEASUREMENT_ID="your_ga_measurement_id"
